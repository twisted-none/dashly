TZ=Europe/Moscow

# Domains
DASHLY_DOMAIN=dash.example.com
DASHLY_API_DOMAIN=api.dash.example.com
KEYCLOAK_DOMAIN=auth.dash.example.com
DASHLY_FRONTEND_URL=https://dash.example.com
DASHLY_BACKEND_URL=https://api.dash.example.com
KEYCLOAK_URL=https://auth.dash.example.com

# PostgreSQL
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_USER=dashly
POSTGRES_PASSWORD=change_me
POSTGRES_PASSWORD_URLENC=change_me
POSTGRES_DB_KEYCLOAK=keycloak
POSTGRES_DB_DASHLY=dashly

# Keycloak / Dashly
KEYCLOAK_HOST=auth.dash.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_REALM=dashly
KEYCLOAK_CLIENT_ID_FRONTEND=dashly-frontend
KEYCLOAK_CLIENT_ID_BACKEND=dashly-backend

# Frontend embeds
GRAFANA_BASE_URL=https://grafana.devops.example.com
